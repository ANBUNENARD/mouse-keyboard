<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="viewmodel"
            type="com.darusc.mousedroid.viewmodels.TouchpadViewModel" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#1a1d24"
        android:orientation="vertical"
        android:padding="6dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Drag the mouse to hover — Tap = Left click — Two-finger tap = Right click — Drag the wheel to scroll"
            android:textColor="#8b8b8b"
            android:textSize="12sp"
            android:layout_marginBottom="6dp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/touchpad_bg"
            android:contentDescription="Mouse hover area">

            <View
                android:id="@+id/mousePadSensor"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clickable="true"
                android:focusable="true" />

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center">

                <ImageView
                    android:layout_width="150dp"
                    android:layout_height="220dp"
                    android:src="@drawable/mouse"
                    android:contentDescription="Remote mouse" />

                <View
                    android:id="@+id/mouseWheel"
                    android:layout_width="34dp"
                    android:layout_height="56dp"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="30dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Scroll wheel — drag up or down to scroll" />
            </FrameLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLeftClick"
                style="@style/ComboMouseButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:onClick="@{viewmodel::onMouseButtonClick}"
                android:text="Left" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRightClick"
                style="@style/ComboMouseButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:onClick="@{viewmodel::onMouseButtonClick}"
                android:text="Right" />
        </LinearLayout>
    </LinearLayout>
</layout>
