<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:id="@+id/kbRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/keyboard_bg"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="2dp">

        <!-- Row 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/k_esc"
                    style="@style/KeyboardKeySmall"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_margin="1dp"
                    android:layout_weight="1.2"
                    android:text="Esc" />
                <Button
                    android:id="@+id/k_grave"
                    style="@style/KeyboardKey"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_margin="1dp"
                    android:layout_weight="1"
                    android:text="`&#8203;" />
                <Button
                    android:id="@+id/k_1"
                    style="@style/KeyboardKey"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_margin="1dp"
                    android:layout_weight="1"
                    android:text="1" />
                <Button
                    android:id="@+id/k_2"
                    style="@style/KeyboardKey"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_margin="1dp"
                    android:layout_weight="1"
                    android:text="2" />
                <Button
                    android:id="@+id/k_3"
                    style="@style/KeyboardKey"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_margin="1dp"
                    android:layout_weight="1"
                    android:text="3" />
                <Button
                    android:id="@+id/k_4"
                    style="@style/KeyboardKey"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_margin="1dp"
                    android:layout_weight="1"
                    android:text="4" />
                <Button
                    android:id="@+id/k_5"
                    style="@style/KeyboardKey"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_margin="1dp"
                    android:layout_weight="1"
                    android:text="5" />
                <Button
                    android:id="@+id/k_6"
                    style="@style/KeyboardKey"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_margin="1dp"
                    android:layout_weight="1"
                    android:text="6" />
                <Button
                    android:id="@+id/k_7"
                    style="@style/KeyboardKey"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_margin="1dp"
                    android:layout_weight="1"
                    android:text="7" />
                <Button
                    android:id="@+id/k_8"
                    style="@style/KeyboardKey"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_margin="1dp"
                    android:layout_weight="1"
                    android:text="8" />
                <Button
                    android:id="@+id/k_9"
                    style="@style/KeyboardKey"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_margin="1dp"
                    android:layout_weight="1"
                    android:text="9" />
                <Button
                    android:id="@+id/k_0"
                    style="@style/KeyboardKey"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_margin="1dp"
                    android:layout_weight="1"
                    android:text="0" />
                <Button
                    android:id="@+id/k_minus"
                    style="@style/KeyboardKey"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_margin="1dp"
                    android:layout_weight="1"
                    android:text="-" />
                <Button
                    android:id="@+id/k_equal"
                    style="@style/KeyboardKey"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_margin="1dp"
                    android:layout_weight="1"
                    android:text="=" />
                <Button
                    android:id="@+id/k_backspace"
                    style="@style/KeyboardKeySymbol"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_margin="1dp"
                    android:layout_weight="1.6"
                    android:text="&#9003;" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="126dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/k_home"
                    style="@style/KeyboardKeySmall"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_margin="1dp"
                    android:layout_weight="1"
                    android:text="Home" />
                <Button
                    android:id="@+id/k_pgup"
                    style="@style/KeyboardKeySmall"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_margin="1dp"
                    android:layout_weight="1"
                    android:text="PgUp" />
                <Button
                    android:id="@+id/k_nav"
                    style="@style/KeyboardKeySmall"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_margin="1dp"
                    android:layout_weight="1"
                    android:enabled="false"
                    android:text="Nav" />
            </LinearLayout>
        </LinearLayout>

        <!-- Row 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/k_tab"
                    style="@style/KeyboardKeySmall"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_margin="1dp"
                    android:layout_weight="1.5"
                    android:text="Tab" />
                <Button
                    android:id="@+id/k_q"
                    style="@style/KeyboardKey"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_margin="1dp"
                    android:layout_weight="1"
                    android:text="Q" />
                <Button
                    android:id="@+id/k_w"
                    style="@style/KeyboardKey"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_margin="1dp"
                    android:layout_weight="1"
                    android:text="W" />
                <Button
                    android:id="@+id/k_e"
                    style="@style/KeyboardKey"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_margin="1dp"
                    android:layout_weight="1"
                    android:text="E" />
                <Button
                    android:id="@+id/k_r"
                    style="@style/KeyboardKey"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_margin="1dp"
                    android:layout_weight="1"
                    android:text="R" />
                <Button
                    android:id="@+id/k_t"
                    style="@style/KeyboardKey"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_margin="1dp"
                    android:layout_weight="1"
                    android:text="T" />
                <Button
                    android:id="@+id/k_y"
                    style="@style/KeyboardKey"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_margin="1dp"
                    android:layout_weight="1"
                    android:text="Y" />
                <Button
                    android:id="@+id/k_u"
                    style="@style/KeyboardKey"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_margin="1dp"
                    android:layout_weight="1"
                    android:text="U" />
                <Button
                    android:id="@+id/k_i"
                    style="@style/KeyboardKey"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_margin="1dp"
                    android:layout_weight="1"
                    android:text="I" />
                <Button
                    android:id="@+id/k_o"
                    style="@style/KeyboardKey"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_margin="1dp"
                    android:layout_weight="1"
                    android:text="O" />
                <Button
                    android:id="@+id/k_p"
                    style="@style/KeyboardKey"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_margin="1dp"
                    android:layout_weight="1"
                    android:text="P" />
                <Button
                    android:id="@+id/k_lbracket"
                    style="@style/KeyboardKey"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_margin="1dp"
                    android:layout_weight="1"
                    android:text="[" />
                <Button
                    android:id="@+id/k_rbracket"
                    style="@style/KeyboardKey"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_margin="1dp"
                    android:layout_weight="1"
                    android:text="]" />
                <Button
                    android:id="@+id/k_backslash"
                    style="@style/KeyboardKey"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_margin="1dp"
                    android:layout_weight="1"
                    android:text="\\" />
                <Button
                    android:id="@+id/k_del"
                    style="@style/KeyboardKeySmall"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_margin="1dp"
                    android:layout_weight="1.2"
                    android:text="Del" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="126dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/k_end"
                    style="@style/KeyboardKeySmall"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_margin="1dp"
                    android:layout_weight="1"
                    android:text="End" />
                <Button
                    android:id="@+id/k_pgdn"
                    style="@style/KeyboardKeySmall"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_margin="1dp"
                    android:layout_weight="1"
                    android:text="PgDn" />
                <Button
                    android:id="@+id/k_mvup"
                    style="@style/KeyboardKeySymbol"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_margin="1dp"
                    android:layout_weight="1"
                    android:text="&#8593;" />
            </LinearLayout>
        </LinearLayout>

        <!-- Row 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/k_caps"
                    style="@style/KeyboardKeySmall"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_margin="1dp"
                    android:layout_weight="1.6"
                    android:text="Caps" />
                <Button
                    android:id="@+id/k_a"
                    style="@style/KeyboardKey"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_margin="1dp"
                    android:layout_weight="1"
                    android:text="A" />
                <Button
                    android:id="@+id/k_s"
                    style="@style/KeyboardKey"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_margin="1dp"
                    android:layout_weight="1"
                    android:text="S" />
                <Button
                    android:id="@+id/k_d"
                    style="@style/KeyboardKey"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_margin="1dp"
                    android:layout_weight="1"
                    android:text="D" />
                <Button
                    android:id="@+id/k_f"
                    style="@style/KeyboardKey"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_margin="1dp"
                    android:layout_weight="1"
                    android:text="F" />
                <Button
                    android:id="@+id/k_g"
                    style="@style/KeyboardKey"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_margin="1dp"
                    android:layout_weight="1"
                    android:text="G" />
                <Button
                    android:id="@+id/k_h"
                    style="@style/KeyboardKey"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_margin="1dp"
                    android:layout_weight="1"
                    android:text="H" />
                <Button
                    android:id="@+id/k_j"
                    style="@style/KeyboardKey"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_margin="1dp"
                    android:layout_weight="1"
                    android:text="J" />
                <Button
                    android:id="@+id/k_k"
                    style="@style/KeyboardKey"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_margin="1dp"
                    android:layout_weight="1"
                    android:text="K" />
                <Button
                    android:id="@+id/k_l"
                    style="@style/KeyboardKey"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_margin="1dp"
                    android:layout_weight="1"
                    android:text="L" />
                <Button
                    android:id="@+id/k_semi"
                    style="@style/KeyboardKey"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_margin="1dp"
                    android:layout_weight="1"
                    android:text=";" />
                <Button
                    android:id="@+id/k_quote"
                    style="@style/KeyboardKey"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_margin="1dp"
                    android:layout_weight="1"
                    android:text="'" />
                <Button
                    android:id="@+id/k_enter"
                    style="@style/KeyboardKeySmall"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_margin="1dp"
                    android:layout_weight="2"
                    android:text="Enter" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="126dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/k_ins"
                    style="@style/KeyboardKeySmall"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_margin="1dp"
                    android:layout_weight="1"
                    android:text="Ins" />
                <Button
                    android:id="@+id/k_pause"
                    style="@style/KeyboardKeySmall"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_margin="1dp"
                    android:layout_weight="1"
                    android:text="Pause" />
                <Button
                    android:id="@+id/k_mvdn"
                    style="@style/KeyboardKeySymbol"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_margin="1dp"
                    android:layout_weight="1"
                    android:text="&#8595;" />
            </LinearLayout>
        </LinearLayout>

        <!-- Row 4 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/k_shift"
                    style="@style/KeyboardKeySmall"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_margin="1dp"
                    android:layout_weight="1.8"
                    android:text="Shift" />
                <Button
                    android:id="@+id/k_z"
                    style="@style/KeyboardKey"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_margin="1dp"
                    android:layout_weight="1"
                    android:text="Z" />
                <Button
                    android:id="@+id/k_x"
                    style="@style/KeyboardKey"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_margin="1dp"
                    android:layout_weight="1"
                    android:text="X" />
                <Button
                    android:id="@+id/k_c"
                    style="@style/KeyboardKey"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_margin="1dp"
                    android:layout_weight="1"
                    android:text="C" />
                <Button
                    android:id="@+id/k_v"
                    style="@style/KeyboardKey"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_margin="1dp"
                    android:layout_weight="1"
                    android:text="V" />
                <Button
                    android:id="@+id/k_b"
                    style="@style/KeyboardKey"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_margin="1dp"
                    android:layout_weight="1"
                    android:text="B" />
                <Button
                    android:id="@+id/k_n"
                    style="@style/KeyboardKey"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_margin="1dp"
                    android:layout_weight="1"
                    android:text="N" />
                <Button
                    android:id="@+id/k_m"
                    style="@style/KeyboardKey"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_margin="1dp"
                    android:layout_weight="1"
                    android:text="M" />
                <Button
                    android:id="@+id/k_comma"
                    style="@style/KeyboardKey"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_margin="1dp"
                    android:layout_weight="1"
                    android:text="," />
                <Button
                    android:id="@+id/k_dot"
                    style="@style/KeyboardKey"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_margin="1dp"
                    android:layout_weight="1"
                    android:text="." />
                <Button
                    android:id="@+id/k_slash"
                    style="@style/KeyboardKey"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_margin="1dp"
                    android:layout_weight="1"
                    android:text="/" />
                <Button
                    android:id="@+id/k_up"
                    style="@style/KeyboardKeySymbol"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_margin="1dp"
                    android:layout_weight="1"
                    android:text="&#8593;" />
                <Button
                    android:id="@+id/k_shift_r"
                    style="@style/KeyboardKeySmall"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_margin="1dp"
                    android:layout_weight="1.8"
                    android:text="Shift" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="126dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/k_prtsc"
                    style="@style/KeyboardKeySmall"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_margin="1dp"
                    android:layout_weight="1"
                    android:text="PrtSc" />
                <Button
                    android:id="@+id/k_scrlk"
                    style="@style/KeyboardKeySmall"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_margin="1dp"
                    android:layout_weight="1"
                    android:text="ScrLk" />
                <Button
                    android:id="@+id/k_dock"
                    style="@style/KeyboardKeySmall"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_margin="1dp"
                    android:layout_weight="1"
                    android:enabled="false"
                    android:text="Dock" />
            </LinearLayout>
        </LinearLayout>

        <!-- Row 5 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/k_fn"
                    style="@style/KeyboardKeySmall"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_margin="1dp"
                    android:layout_weight="0.9"
                    android:text="Fn" />
                <Button
                    android:id="@+id/k_ctrl"
                    style="@style/KeyboardKeySmall"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_margin="1dp"
                    android:layout_weight="0.9"
                    android:text="Ctrl" />
                <Button
                    android:id="@+id/k_win"
                    style="@style/KeyboardKeySymbol"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_margin="1dp"
                    android:layout_weight="0.9"
                    android:text="&#8862;" />
                <Button
                    android:id="@+id/k_alt"
                    style="@style/KeyboardKeySmall"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_margin="1dp"
                    android:layout_weight="0.9"
                    android:text="Alt" />
                <Button
                    android:id="@+id/k_space"
                    style="@style/KeyboardKeySmall"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_margin="1dp"
                    android:layout_weight="3.4"
                    android:text="Space" />
                <Button
                    android:id="@+id/k_alt_r"
                    style="@style/KeyboardKeySmall"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_margin="1dp"
                    android:layout_weight="0.9"
                    android:text="Alt" />
                <Button
                    android:id="@+id/k_ctrl_r"
                    style="@style/KeyboardKeySmall"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_margin="1dp"
                    android:layout_weight="0.9"
                    android:text="Ctrl" />
                <Button
                    android:id="@+id/k_left"
                    style="@style/KeyboardKeySymbol"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_margin="1dp"
                    android:layout_weight="0.9"
                    android:text="&#8592;" />
                <Button
                    android:id="@+id/k_down"
                    style="@style/KeyboardKeySymbol"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_margin="1dp"
                    android:layout_weight="0.9"
                    android:text="&#8595;" />
                <Button
                    android:id="@+id/k_right"
                    style="@style/KeyboardKeySymbol"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_margin="1dp"
                    android:layout_weight="0.9"
                    android:text="&#8594;" />
                <Button
                    android:id="@+id/k_menu"
                    style="@style/KeyboardKeySymbol"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_margin="1dp"
                    android:layout_weight="0.9"
                    android:text="&#9783;" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="126dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/k_options"
                    style="@style/KeyboardKeySmall"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_margin="1dp"
                    android:layout_weight="1"
                    android:text="Opt" />
                <Button
                    android:id="@+id/k_help"
                    style="@style/KeyboardKeySmall"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_margin="1dp"
                    android:layout_weight="1"
                    android:text="Help" />
                <Button
                    android:id="@+id/k_fade"
                    style="@style/KeyboardKeySmall"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_margin="1dp"
                    android:layout_weight="1"
                    android:enabled="false"
                    android:text="Fade" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</layout>
