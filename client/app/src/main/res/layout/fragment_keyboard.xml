                            style="@style/KeyboardKey"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_weight="1"
                            android:text="p"
                            android:textSize="13sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/k_lbracket"
                            style="@style/KeyboardKey"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_weight="1"
                            android:text="{\n["
                            android:textSize="11sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/k_rbracket"
                            style="@style/KeyboardKey"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_weight="1"
                            android:text="}\n]"
                            android:textSize="11sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/k_backslash"
                            style="@style/KeyboardKey"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_weight="1"
                            android:text="|\n\\"
                            android:textSize="11sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/k_del"
                            style="@style/KeyboardKey"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_weight="1.2"
                            android:text="Del"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="132dp"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/k_end"
                            style="@style/KeyboardKey"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_weight="1"
                            android:text="End"
                            android:textSize="9sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/k_pgdn"
                            style="@style/KeyboardKey"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_weight="1"
                            android:text="PgDn"
                            android:textSize="9sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/k_mvup"
                            style="@style/KeyboardKey"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_weight="1"
                            android:text="Mv Up"
                            android:textSize="9sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Row 3: Caps + home row + Enter | Insert Pause MvDn -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/k_caps"
                            style="@style/KeyboardKey"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_weight="1.6"
                            android:text="Caps"
                            android:textSize="11sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/k_a"
                            style="@style/KeyboardKey"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_weight="1"
                            android:text="a"
                            android:textSize="13sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/k_s"
                            style="@style/KeyboardKey"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_weight="1"
                            android:text="s"
                            android:textSize="13sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/k_d"
                            style="@style/KeyboardKey"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_weight="1"
