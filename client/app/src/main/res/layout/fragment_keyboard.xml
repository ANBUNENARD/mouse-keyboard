                            android:layout_height="52dp"
                            android:layout_weight="1"
                            android:text="y"
                            android:textSize="13sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/k_u"
                            style="@style/KeyboardKey"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_weight="1"
                            android:text="u"
                            android:textSize="13sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/k_i"
                            style="@style/KeyboardKey"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_weight="1"
                            android:text="i"
                            android:textSize="13sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/k_o"
                            style="@style/KeyboardKey"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_weight="1"
                            android:text="o"
                            android:textSize="13sp" />

                        <com.google.android.material.button.MaterialButton
