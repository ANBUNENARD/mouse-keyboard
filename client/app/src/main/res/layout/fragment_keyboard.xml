                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/k_scrlk"
                            style="@style/KeyboardKey"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_weight="1"
                            android:text="ScrLk"
                            android:textSize="9sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/k_dock"
                            style="@style/KeyboardKey"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_weight="1"
                            android:enabled="false"
                            android:text="Dock"
                            android:textSize="9sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Row 5: Fn Ctrl Win Alt Space Alt Ctrl arrows menu | Options Help Fade -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="8dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/k_fn"
                            style="@style/KeyboardKey"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_weight="0.9"
                            android:text="Fn"
                            android:textSize="11sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/k_ctrl"
                            style="@style/KeyboardKey"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_weight="0.9"
                            android:text="Ctrl"
                            android:textSize="11sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/k_win"
                            style="@style/KeyboardKey"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_weight="0.9"
                            android:text="&#8862;"
                            android:textSize="14sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/k_alt"
                            style="@style/KeyboardKey"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_weight="0.9"
                            android:text="Alt"
                            android:textSize="11sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/k_space"
                            style="@style/KeyboardKey"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_weight="3.4"
                            android:text="Space"
                            android:textSize="11sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/k_alt_r"
                            style="@style/KeyboardKey"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_weight="0.9"
                            android:text="Alt"
                            android:textSize="11sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/k_ctrl_r"
                            style="@style/KeyboardKey"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_weight="0.9"
                            android:text="Ctrl"
                            android:textSize="11sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/k_left"
                            style="@style/KeyboardKey"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_weight="0.9"
                            android:text="&#8592;"
                            android:textSize="14sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/k_down"
                            style="@style/KeyboardKey"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_weight="0.9"
                            android:text="&#8595;"
                            android:textSize="14sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/k_right"
                            style="@style/KeyboardKey"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_weight="0.9"
                            android:text="&#8594;"
                            android:textSize="14sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/k_menu"
                            style="@style/KeyboardKey"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_weight="0.9"
                            android:text="&#9783;"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="132dp"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/k_options"
                            style="@style/KeyboardKey"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_weight="1"
                            android:text="Options"
                            android:textSize="9sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/k_help"
                            style="@style/KeyboardKey"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_weight="1"
                            android:text="Help"
                            android:textSize="9sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/k_fade"
                            style="@style/KeyboardKey"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_weight="1"
                            android:enabled="false"
                            android:text="Fade"
                            android:textSize="9sp" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>
