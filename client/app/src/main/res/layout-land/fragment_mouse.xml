<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="viewmodel"
            type="com.darusc.mousedroid.viewmodels.TouchpadViewModel" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#1a1d24"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:padding="6dp">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="62"
            android:background="@drawable/touchpad_bg"
            android:contentDescription="Mouse hover area">

            <View
                android:id="@+id/mousePadSensor"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clickable="true"
                android:focusable="true" />

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center">

                <ImageView
                    android:layout_width="130dp"
                    android:layout_height="190dp"
                    android:src="@drawable/mouse"
                    android:contentDescription="Remote mouse" />

                <View
                    android:id="@+id/mouseWheel"
                    android:layout_width="32dp"
                    android:layout_height="50dp"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="26dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Scroll wheel — drag up or down to scroll" />
            </FrameLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="38"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Drag to hover. Tap = Left. Two-finger tap = Right. Wheel = Scroll."
                android:textColor="#8b8b8b"
                android:textSize="12sp"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLeftClick"
                style="@style/ComboMouseButton"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginBottom="6dp"
                android:onClick="@{viewmodel::onMouseButtonClick}"
                android:text="Left" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRightClick"
                style="@style/ComboMouseButton"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:onClick="@{viewmodel::onMouseButtonClick}"
                android:text="Right" />
        </LinearLayout>
    </LinearLayout>
</layout>
